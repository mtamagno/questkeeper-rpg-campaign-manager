{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "questkeeper-shell",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "questkeeper-brand",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "campaign-directory",
      "urls": ["/campaigns/campaigns.json", "/campaigns/*/data/campaign.json"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 32,
        "maxAge": "7d",
        "timeout": "3s"
      }
    },
    {
      "name": "campaign-public-media",
      "urls": ["/campaigns/**/images/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 80,
        "maxAge": "30d"
      }
    }
  ]
}
