{
  "name": "questkeeper-rpg-campaign-manager",
  "version": "1.1.4",
  "description": "A self-hosted D&D and tabletop RPG companion for character sheets, session journals, party bonds, maps and campaign lore.",
  "questkeeper": {
    "releaseChannel": "lts"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "ng": "ng",
    "manage": "node tools/campaign-manager/server.mjs",
    "prepare:campaigns": "node scripts/materialize-user-campaigns.cjs",
    "start": "npm run prepare:campaigns && ng serve",
    "build": "npm run prepare:campaigns && node scripts/generate-thumbnails.cjs && node scripts/generate-display-images.cjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:manager": "node --test tools/campaign-manager/tests/*.test.mjs",
    "test:storage": "node --test tools/campaign-manager/tests/storage-paths.test.mjs",
    "test:entity-ids": "npm run prepare:campaigns && node tools/campaign-manager/verify-entity-ids.mjs",
    "test:transcriber": "cd discord-transcriber && python -m unittest discover -s tests",
    "test:design-system": "node scripts/verify-design-system.cjs",
    "test:first-visit": "node scripts/verify-first-visit.cjs",
    "test:guided-tour": "node scripts/verify-guided-tour.cjs",
    "test:pwa": "node scripts/verify-pwa.cjs",
    "test:offline": "node scripts/verify-offline-pack.cjs",
    "test:command-palette": "node scripts/verify-command-palette.cjs",
    "test:journey-memory": "node scripts/verify-journey-memory.cjs",
    "test:my-character": "node scripts/verify-my-character.cjs",
    "test:user-settings": "node scripts/verify-user-settings.cjs",
    "test:character-reading-position": "node scripts/verify-character-reading-position.cjs",
    "test:lightbox-loading": "node scripts/verify-lightbox-loading.cjs",
    "test:level-comparison": "node scripts/verify-level-history-comparison.cjs",
    "test:demo": "node scripts/verify-lantern-road.cjs",
    "test:game-night-brief": "node scripts/verify-game-night-brief.cjs",
    "test:table-moments": "node scripts/verify-table-moments.cjs",
    "test:notebooks": "node scripts/verify-character-notebooks.cjs",
    "test:character-profiles": "node scripts/verify-character-story-profiles.cjs",
    "test:accessibility": "node scripts/verify-accessibility.cjs",
    "test:performance": "node scripts/verify-performance-budgets.cjs",
    "test:installer": "node scripts/verify-installer.cjs",
    "test:release": "node scripts/verify-release.cjs",
    "build:setup": "node scripts/build-setup-binary.cjs",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:design-system && npm run test:first-visit && npm run test:guided-tour && npm run test:pwa && npm run test:offline && npm run test:command-palette && npm run test:journey-memory && npm run test:my-character && npm run test:user-settings && npm run test:character-reading-position && npm run test:lightbox-loading && npm run test:level-comparison && npm run test:demo && npm run test:game-night-brief && npm run test:table-moments && npm run test:notebooks && npm run test:character-profiles && npm run test:accessibility && npm run test:installer && npm run test:release && npm run test:manager && npm run test:entity-ids && npm run test:transcriber && npm run build && npm run test:performance",
    "generate:thumbs": "node scripts/generate-thumbnails.cjs",
    "generate:display": "node scripts/generate-display-images.cjs"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "21.2.25",
    "basic-ftp": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.13.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2"
  }
}
