{
  "name": "questkeeper-rpg-campaign-manager",
  "version": "1.1.2",
  "description": "A self-hosted D&D and tabletop RPG companion for character sheets, session journals, party bonds, maps and campaign lore.",
  "scripts": {
    "ng": "ng",
    "manage": "node tools/campaign-manager/server.mjs",
    "start": "ng serve",
    "build": "node scripts/generate-thumbnails.cjs && node scripts/generate-display-images.cjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:manager": "node --test tools/campaign-manager/tests/*.test.mjs",
    "test:transcriber": "cd discord-transcriber && python -m unittest discover -s tests",
    "test:design-system": "node scripts/verify-design-system.cjs",
    "test:first-visit": "node scripts/verify-first-visit.cjs",
    "test:guided-tour": "node scripts/verify-guided-tour.cjs",
    "test:pwa": "node scripts/verify-pwa.cjs",
    "test:installer": "node scripts/verify-installer.cjs",
    "test:release": "node scripts/verify-release.cjs",
    "build:setup": "node scripts/build-setup-binary.cjs",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test:design-system && npm run test:first-visit && npm run test:guided-tour && npm run test:pwa && npm run test:installer && npm run test:release && npm run test:manager && npm run test:transcriber && npm run build",
    "generate:thumbs": "node scripts/generate-thumbnails.cjs",
    "generate:display": "node scripts/generate-display-images.cjs"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@angular/service-worker": "21.2.25",
    "basic-ftp": "^6.2.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.13.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2"
  }
}
